#!/usr/bin/env python3
"""Check a built docs site makes no third-party requests: scripts, styles,
fonts, images and frames must all come from the site itself.

    scripts/check-docs-site site/
"""

import re
import sys
from pathlib import Path

# Attributes that make the browser fetch something on page load. Plain links
# (<a href>) are fine: they're only followed when clicked.
FETCHING = re.compile(
    r"<(script|img|iframe|source|video|audio|embed)\b[^>]*\bsrc=[\"']([^\"']+)"
    r"|<link\b(?=[^>]*\brel=[\"'](?:stylesheet|preload|preconnect|dns-prefetch|icon|modulepreload)[\"'])[^>]*\bhref=[\"']([^\"']+)",
    re.I,
)
CSS_URL = re.compile(r"url\(\s*[\"']?(https?:)?//", re.I)


def main(site: Path) -> int:
    problems = []
    for page in site.rglob("*.html"):
        for m in FETCHING.finditer(page.read_text(errors="replace")):
            url = m.group(2) or m.group(3)
            if re.match(r"^(https?:)?//", url) and "thermoslop.com" not in url:
                problems.append(f"{page.relative_to(site)}: {url}")
        # Material's repository widget fetches api.github.com at runtime (repo_url).
        if 'data-md-component="source"' in page.read_text(errors="replace"):
            problems.append(f"{page.relative_to(site)}: repository widget (calls api.github.com); drop repo_url")
    for css in site.rglob("*.css"):
        if CSS_URL.search(css.read_text(errors="replace")):
            problems.append(f"{css.relative_to(site)}: external url() in CSS")
    for p in problems:
        print(f"third-party request: {p}", file=sys.stderr)
    pages = len(list(site.rglob("*.html")))
    print(f"check-docs-site: {pages} pages, {len(problems)} third-party requests")
    return 1 if problems or not pages else 0


if __name__ == "__main__":
    sys.exit(main(Path(sys.argv[1] if len(sys.argv) > 1 else "site")))
