#!/usr/bin/env python3
"""Promote the current plugin release to the Omarchy plugin marketplace.

After a release, the marketplace keeps showing the previously verified
commit ("Update unverified") until the new one is verified. This prints what
the marketplace's verification form needs, and a pre-filled link:

  scripts/marketplace-promote            print the values and the form link
  scripts/marketplace-promote --submit   open the issue with `gh` instead

The commit is the plugin repo's current HEAD (the release workflow's sync
commit), read with `git ls-remote`, so no checkout is needed.
"""

import json
import subprocess
import sys
import tempfile
import urllib.parse
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PLUGIN_REPO = "https://github.com/martellj/thermoslop-omarchy"
MARKETPLACE = "omacom/omarchy-plugin-marketplace"
ACTION = "Verify and publish a newer upstream commit"


def main() -> int:
    plugin_id = json.loads((ROOT / "omarchy/martellj.thermoslop/manifest.json").read_text())["id"]
    heads = subprocess.run(["git", "ls-remote", PLUGIN_REPO, "HEAD"], capture_output=True, text=True, check=True)
    commit = heads.stdout.split()[0]
    print(f"Plugin ID:      {plugin_id}\nRepository URL: {PLUGIN_REPO}\nTarget commit:  {commit}")

    if "--submit" not in sys.argv:
        query = urllib.parse.urlencode({
            "template": "verify-plugin.yml", "plugin-id": plugin_id, "repository": PLUGIN_REPO, "target-commit": commit,
        })
        print(f"\nForm (choose \"{ACTION}\" and tick the acknowledgment):\n"
              f"https://github.com/{MARKETPLACE}/issues/new?{query}")
        return 0

    body = f"""### Verification action

{ACTION}

### Plugin ID

{plugin_id}

### Repository URL

{PLUGIN_REPO}

### Target commit

{commit}

### Verification acknowledgment

- [x] I understand that only the exact target commit can become a verified marketplace snapshot and that verification is not a security audit.

### Standard installation acknowledgment

- [ ] I confirm that this listed root plugin supports the standard Omarchy installation path and does not require manual setup.
"""
    with tempfile.NamedTemporaryFile("w", suffix=".md", delete=False) as f:
        f.write(body)
    title = f"[Verify]: {plugin_id} {commit[:7]}"
    return subprocess.run(["gh", "issue", "create", "-R", MARKETPLACE, "--title", title, "--body-file", f.name]).returncode


if __name__ == "__main__":
    sys.exit(main())
