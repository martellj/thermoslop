build() {
  cd "$srcdir/thermoslop-$pkgver"
  python -m build --wheel --no-isolation --outdir "$srcdir/wheels"
  cd "$srcdir/chacha20poly1305-0.0.3"
  python -m build --wheel --no-isolation --outdir "$srcdir/wheels"
}

package() {
  local lib="$pkgdir/usr/lib/thermoslop" whl
  install -d "$lib"
  # All pure Python with no data files, so unpacking a wheel is installing it.
  for whl in "$srcdir"/wheels/*.whl "$srcdir"/*.whl; do
    python -m zipfile -e "$whl" "$lib"
  done
  python -m compileall -q -d /usr/lib/thermoslop "$lib"
  # -I: ignore PYTHONPATH and user site-packages, so the bundled mcp 2.x wins over any other.
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/thermoslop" <<'LAUNCHER'
#!/usr/bin/python3 -I
import sys
sys.path.insert(0, "/usr/lib/thermoslop")
from thermoslop.cli import main
sys.exit(main())
LAUNCHER
  install -Dm644 "$srcdir/thermoslop-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
